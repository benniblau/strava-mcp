# =============================================================================
# STRAVA API CREDENTIALS
# =============================================================================
# Get these from https://www.strava.com/settings/api

STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# OAuth tokens — auto-updated by strava_downloader.py after each run.
# To get your initial refresh token:
#   1. Visit this, with approval_prompt=force so Strava re-asks even if you
#      have already authorized the app with narrower scopes:
#      https://www.strava.com/oauth/authorize?client_id=YOUR_CLIENT_ID&redirect_uri=http://localhost&response_type=code&approval_prompt=force&scope=activity:read_all,activity:write,profile:read_all
#   2. Authorize, then copy the `code=` value from the localhost URL you land
#      on. The page itself will not load — that is expected.
#   3. Exchange it:  python strava_downloader.py --authorize <code>
#      That writes the three values below for you. Codes are single-use and
#      expire quickly, so fetch a fresh one if it fails.
#
# Scopes:
#   activity:read_all  read activities, including "Only Me" ones
#   profile:read_all   read the athlete profile
#   activity:write     upload and edit activities — needed only for the
#                      upload_activity / update_activity tools. Leave it out
#                      to keep the token read-only.
#
# Changing scopes requires a fresh authorization: a refresh token carries
# forward whatever it was granted and cannot widen itself.
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_TOKEN_EXPIRES_AT=0

# =============================================================================
# SYNC SETTINGS
# =============================================================================

STRAVA_DB_PATH=./strava_activities.db

# Optional: earliest date to sync activities from (YYYY-MM-DD).
# If not set, defaults to 2 years back from today.
STRAVA_START_DATE=2020-01-01

# =============================================================================
# MCP SERVER HTTP TRANSPORT
# =============================================================================

# "http" for remote MCP clients, "stdio" for local Claude Desktop.
# Defaults to "http" when unset.
STRAVA_MCP_TRANSPORT=http

# Required when STRAVA_MCP_TRANSPORT=http.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
STRAVA_MCP_AUTH_TOKEN=

STRAVA_MCP_HTTP_HOST=0.0.0.0
STRAVA_MCP_HTTP_PORT=8080
